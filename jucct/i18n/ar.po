msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #FFFFFF; font-family:Verdana, Arial,sans-serif; color: #333; width: 100%; border-collapse:separate;\">\n"
"    <tr>\n"
"        <td align=\"center\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color: #fff; padding: 16px;\">\n"
"                <tr>\n"
"                    <td style=\"font-size: 13px;\">\n"
"                        <p>Dear <strong t-out=\"object.partner_id.name or ''\">Student</strong>,</p>\n"
"                        <p>\n"
"                            We are pleased to share your <strong>Enrollment Invoice</strong> <strong t-out=\"object.name or ''\"/>.\n"
"                        </p>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            <p>\n"
"                                (Registration Ref: <t t-out=\"object.invoice_origin or ''\"/>)\n"
"                            </p>\n"
"                        </t>\n"
"                        <p>\n"
"                            Amounting to <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/> from <t t-out=\"object.company_id.name or ''\"/>.\n"
"                        </p>\n"
"                        <t t-if=\"object.partner_id.university_id\">\n"
"                            <p>\n"
"                                <strong>Student ID:</strong> <t t-out=\"object.partner_id.university_id\"/>\n"
"                            </p>\n"
"                        </t>\n"
"                        <br/>\n"
"                        <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                            <p>\n"
"                                This invoice has been <strong>paid</strong>. Thank you for your prompt payment.\n"
"                            </p>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <p>\n"
"                                Please complete the payment at your earliest convenience.\n"
"                            </p>\n"
"                            <t t-if=\"object.payment_reference\">\n"
"                                <p>\n"
"                                    Kindly use the following reference when making your payment: <strong t-out=\"object.payment_reference or ''\"/>.\n"
"                                </p>\n"
"                                <t t-if=\"object.partner_bank_id\">\n"
"                                    <p>\n"
"                                        Payment can be made to: <strong t-out=\"object.partner_bank_id.acc_number\"/>.\n"
"                                    </p>\n"
"                                </t>\n"
"                            </t>\n"
"                        </t>\n"
"                        <br/>\n"
"                        <p>\n"
"                            For any questions about your enrollment or payment, please contact us at\n"
"                            <a t-att-href=\"'mailto:%s' % (object.company_id.email or user.email or 'info@example.com')\">\n"
"                                <t t-out=\"object.company_id.email or user.email or 'info@example.com'\"/>\n"
"                            </a>.\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</table>"
msgstr ""
"<div t-att-style=\"'direction: rtl; text-align: right; font-family: Cairo, Noto Naskh Arabic, sans-serif;' if ctx.get('lang','').startswith('ar') else 'direction: ltr; text-align: left;'\">\n"
"<table dir=\"rtl\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"direction:rtl; text-align:right; padding-top: 16px; background-color: #FFFFFF; font-family:Verdana, Arial,sans-serif; color: #333; width: 100%; border-collapse:separate;\">\n"
"    <tr>\n"
"        <td align=\"center\">\n"
"            <table dir=\"rtl\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"direction:rtl; text-align:right; background-color: #fff; padding: 16px;\">\n"
"                <tr>\n"
"                    <td dir=\"rtl\" style=\"direction:rtl; text-align:right; font-size: 13px;\">\n"
"                        <p style=\"direction:rtl; text-align:right;\">السيد/ة <strong t-out=\"object.partner_id.name or ''\">Student</strong>،</p>\n"
"                        <p style=\"direction:rtl; text-align:right;\">\n"
"                            يسعدنا أن نرسل لك <strong>فاتورة التسجيل الخاصة بك رقم:</strong> \n"
"                            <span dir=\"ltr\"><strong t-out=\"object.name or ''\"/></span>\n"
"                        </p>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            <p style=\"direction:rtl; text-align:right;\">\n"
"                                (الرقم المرجعي: <span dir=\"ltr\"><t t-out=\"object.invoice_origin or ''\"/></span>)\n"
"                            </p>\n"
"                        </t>\n"
"                        <p style=\"direction:rtl; text-align:right;\">\n"
"                            وذلك بمبلغ <span dir=\"ltr\"><strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/></span> من <span dir=\"ltr\"><t t-out=\"object.company_id.name or ''\"/></span>.\n"
"                        </p>\n"
"                        <t t-if=\"object.partner_id.university_id\">\n"
"                            <p style=\"direction:rtl; text-align:right;\">\n"
"                                <strong>رقم الطالب:</strong> <span dir=\"ltr\"><t t-out=\"object.partner_id.university_id\"/></span>\n"
"                            </p>\n"
"                        </t>\n"
"                        <br/>\n"
"                        <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                            <p style=\"direction:rtl; text-align:right;\">\n"
"                                تم <strong>سداد</strong> هذه الفاتورة. شكراً لالتزامك.\n"
"                            </p>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <p style=\"direction:rtl; text-align:right;\">\n"
"                                يرجى إتمام عملية الدفع في أقرب وقت ممكن.\n"
"                            </p>\n"
"                            <t t-if=\"object.payment_reference\">\n"
"                                <p style=\"direction:rtl; text-align:right;\">\n"
"                                    عند الدفع، يرجى استخدام الرقم المرجعي التالي: \n"
"                                    <span dir=\"ltr\"><strong t-out=\"object.payment_reference or ''\"/></span>.\n"
"                                </p>\n"
"                                <t t-if=\"object.partner_bank_id\">\n"
"                                    <p style=\"direction:rtl; text-align:right;\">\n"
"                                        يمكن التحويل إلى الحساب رقم: \n"
"                                        <span dir=\"ltr\"><strong t-out=\"object.partner_bank_id.acc_number\"/></span>.\n"
"                                    </p>\n"
"                                </t>\n"
"                            </t>\n"
"                        </t>\n"
"                        <br/>\n"
"                        <p style=\"direction:rtl; text-align:right;\">\n"
"                            لأي استفسارات بخصوص التسجيل أو الدفع، يرجى التواصل معنا عبر:\n"
"                            <a t-att-href=\"'mailto:%s' % (object.company_id.email or user.email or 'info@example.com')\">\n"
"                                <t t-out=\"object.company_id.email or user.email or 'info@example.com'\"/>\n"
"                            </a>.\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
"</div>"

