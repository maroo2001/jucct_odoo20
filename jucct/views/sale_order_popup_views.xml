<odoo>
    <record id="view_sale_order_popup_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.popup.wizard.form</field>
        <field name="model">sale.order.popup.wizard</field>
        <field name="arch" type="xml">
            <form string="Enrollment Confirmation" create="false" edit="false">
                <group>
                <group>
                    <field name="year" readonly="1" invisible="program_type != 'diploma'"/>
                    <field name="university_id" readonly="1" invisible="program_type != 'diploma'"/>
                    <field name="program_type" readonly="1"/>
                    </group>
                    <group>
                    <field name="order_id" string="enrollment reference" readonly="1" options="{'no_open': True}" context="{'form_view_ref': 'jucct.enrollment_jucct_form_view', 'list_view_ref': 'jucct.enrollment_jucct_list_view'}"/>
                    <field name="semester" readonly="1" invisible="program_type != 'diploma'"/>
                    </group>
                </group>
                <group>
                <h1>
                <field name="product_ids" string="programs" widget="many2many_tags" readonly="1" context="{'form_view_ref': 'jucct.educational_jucct_form_view', 'list_view_ref': 'jucct.educational_jucct_list_view'}"/>
                </h1>
                </group>
                <footer>
                    <button string="OK" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_enrolment_conflict_wizard_form" model="ir.ui.view">
        <field name="name">enrolment.conflict.wizard.form</field>
        <field name="model">enrolment.conflict.wizard</field>
        <field name="arch" type="xml">
            <form string="Scheduling Conflicts Found">
                <sheet>
                    <field name="message" nolabel="1" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Confirm Anyway" name="action_continue_anyway"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>