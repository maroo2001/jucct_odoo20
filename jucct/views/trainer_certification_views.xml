<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Certification Form View -->
    <record id="trainer_certification_jucct_form_view" model="ir.ui.view">
        <field name="name">trainer.certification.form</field>
        <field name="model">trainer.certification</field>
        <field name="arch" type="xml">
            <form string="Certification">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., PMP, ITIL, AWS Certified..."/>
                            <field name="issuing_organization" placeholder="e.g., PMI, AXELOS, AWS..."/>
                            <field name="certification_number" placeholder="Certificate ID or Number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="active" widget="boolean_toggle" readonly="1"/>
                            <field name="is_expired" invisible="1"/>
                        </group>
                    </group>
                    
                    <group string="Certificate Document">
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                    
                    <group>
                        <field name="trainer_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Certification List View -->
    <record id="trainer_certification_jucct_list_view" model="ir.ui.view">
        <field name="name">trainer.certification.list</field>
        <field name="model">trainer.certification</field>
        <field name="arch" type="xml">
            <list string="Certifications" decoration-muted="is_expired">
                <field name="name"/>
                <field name="issuing_organization"/>
                <field name="certification_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="is_expired" invisible="1"/>
                <field name="active" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Certification Search View -->
    <record id="trainer_certification_jucct_search_view" model="ir.ui.view">
        <field name="name">trainer.certification.search</field>
        <field name="model">trainer.certification</field>
        <field name="arch" type="xml">
            <search string="Search Certifications">
                <field name="name"/>
                <field name="issuing_organization"/>
                <field name="trainer_id"/>
                
                <filter name="filter_active" string="Active" 
                        domain="[('active', '=', True)]"/>
                <filter name="filter_expired" string="Expired" 
                        domain="[('active', '=', False)]"/>

            </search>
        </field>
    </record>
</odoo>