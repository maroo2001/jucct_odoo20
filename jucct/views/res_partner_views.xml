<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ################################################################ -->
    <!-- STUDENT VIEWS -->
    <!-- ################################################################ -->
    
    <!-- Student Form View -->
    <record id="student_jucct_form_view" model="ir.ui.view">
        <field name="name">res.partner.form.student</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_enrollments" type="object" icon="school" 
                                class="oe_stat_button" invisible="is_company">
                            <field name="enrollment_count" string="Enrollments" widget="statinfo"/>
                        </button>
                        <button name="action_invoices" type="object" icon="description" 
                                class="oe_stat_button" 
                                groups="jucct.group_reports_analytics,jucct.group_user_management,base.group_system">
                            <field name="invoice_count" string="Invoices" widget="statinfo" />
                        </button>
                        <button name="action_schedule" type="object" icon="calendar_month" 
                                class="oe_stat_button" invisible="is_company">
                            <field name="session_count" string="Schedule" widget="statinfo"/>
                        </button>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>

                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" placeholder="Student Name" invisible="is_company" required="1"/>
                            <field name="name" placeholder="Academy Name" invisible="not is_company" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Student Information" invisible="is_company">
                            <field name="national_id" placeholder="Enter 10-digit National ID" required="1"/>
                            <field name="university_id" readonly="1"/>
                            <field name="email" widget="email"/>
                            <field name="date_of_birth" required="1"/>
                            <field name="country_id"/>
                            <label for="phone" string="Phone"/>
                            <div style="display:flex; align-items:center; gap:0px; margin-left:-2px;">
                                <field name="country_phone_code" readonly="1" nolabel="1" 
                                       style="width:40px; text-align:center;"/>
                                <field name="phone" nolabel="1" placeholder="  Enter 9 digits" 
                                       style="width:250px; margin-left:-2px;"/>
                            </div>
                        </group>

                        <group string="Academy Information" invisible="not is_company">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>

                        <group string="Address">
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State"
                                       options="{'no_open': True, 'no_quick_create': True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country"
                                       options="{'no_open': True, 'no_create': True}" readonly="1"/>
                            </div>
                        </group>
                    </group>

                    <notebook colspan="4">
                        <!-- Enrollments Tab with Popup -->
                        <page string="Enrollments" invisible="is_company">
                            <field name="enrollment_line_ids" 
                                   nolabel="1" 
                                   readonly="1"
                                   context="{'form_view_ref': 'jucct.view_enrollment_line_form_simple'}">
                                <list create="false" delete="false" edit="false">
                                    <field name="program_id" string="Program"/>
                                    <field name="academy_id" string="Academy"/>
                                    <field name="class_offering_id" string="Offering"/>
                                    <field name="semester" optional="show"/>
                                    <field name="year" optional="show"/>
                                    <field name="price_unit" string="Price" optional="show"/>
                                    <field name="order_id" string="Enrollment" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Internal Notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Students List View -->
    <record id="student_jucct_list_view" model="ir.ui.view">
        <field name="name">res.partner.list.student</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Students">
                <control>
                    <button type="action" 
                            name="%(action_student_bulk_import)d" 
                            string="Bulk Import Students"
                            icon="upload"
                            class="btn-primary"/>
                </control>
                
                <field name="name"/>
                <field name="national_id"/>
                <field name="university_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="date_of_birth" optional="show"/>
                <field name="enrolled_academies_display" string="Academies" optional="show"/>
                <field name="enrolled_programs_display" string="Programs" optional="show"/>
                <field name="enrolled_offerings_display" string="Offerings" optional="show"/>
                <field name="enrollment_years" string="Year" optional="show"/>
                <field name="enrollment_semesters" string="Semester" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Students Search View -->
    <record id="student_jucct_search_view" model="ir.ui.view">
        <field name="name">res.partner.search.student</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name" string="Student Name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="national_id"/>
                <field name="university_id"/>
                <field name="email"/>
                <field name="phone"/>
                
                <group>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ################################################################ -->
    <!-- ACADEMY VIEWS -->
    <!-- ################################################################ -->
    
    <!-- Academy Form View -->
    <record id="academy_jucct_form_view" model="ir.ui.view">
        <field name="name">res.partner.form.academy</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Academy">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_academy_sessions" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="calendar_month">
                            <field name="academy_session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        
                        <button name="action_academy_trainers" type="object" class="oe_stat_button" icon="group">
                            <field name="trainer_count" widget="statinfo" string="Trainers"/>
                        </button>

                        <button name="action_view_academy_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="description" groups="jucct.group_reports_analytics,jucct.group_user_management,base.group_system">
                            <field name="academy_invoices_count" widget="statinfo" string="Invoices"/>
                        </button>
                        
                        <button name="action_view_academy_programs"
                                type="object"
                                string="Programs"
                                icon="book"
                                class="oe_stat_button"
                                context="{'default_academy_id': id}">
                            <field name="academy_program_count" widget="statinfo" string="programs"/>
                        </button>
                        
                        <button name="action_view_academy_students" type="object" class="oe_stat_button" icon="school">
                            <field name="academy_students_count" widget="statinfo" string="Students"/>
                        </button>

                        <button name="action_view_settlements" 
                                type="object"
                                class="oe_stat_button"
                                icon="show_chart"
                                groups="jucct.group_reports_analytics,jucct.group_user_management,base.group_system">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Settlements</span>
                            </div>
                        </button>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>

                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" placeholder="Academy Name" required="1"/>
                        </h1>
                        <div>
                            <field name="contract_status" widget="badge" 
                                   decoration-success="contract_status == 'active'"
                                   decoration-danger="contract_status == 'expired'"
                                   decoration-warning="contract_status == 'pending'"/>
                        </div>
                    </div>

                    <notebook colspan="4">
                        <page string="General Information">
                            <group>
                                <group string="Contact Details">
                                    <field name="contact_person"/>
                                    <field name="email" widget="email"/>
                                    <field name="country_id"/>
                                    <label for="phone" string="Phone"/>
                                    <div style="display:flex; align-items:center; gap:0px; margin-left:-2px;">
                                        <field name="country_phone_code" readonly="1" nolabel="1" 
                                            style="width:60px; text-align:center;"/>
                                        <field name="phone" nolabel="1" placeholder="Enter phone number" 
                                            style="width:250px; margin-left:-2px;"/>
                                    </div>
                                </group>
                                <group string="Address">
                                    <field name="street" placeholder="Street..."/>
                                    <field name="street2" placeholder="Street 2..."/>
                                    <field name="city" placeholder="City"/>
                                    <field name="state_id" placeholder="State"
                                           options="{'no_open': True, 'no_quick_create': True}"/>
                                    <field name="zip" placeholder="ZIP"/>
                                </group>
                            </group>
                        </page>

                        <page string="Financial Info">
                            <group>
                                <group string="Bank Details">
                                    <field name="bank_name"/>
                                    <field name="bank_iban"/>
                                </group>
                                <group string="Payment Information">
                                    <field name="payment_term_id" options="{'no_open': True, 'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Contracts / Documents" groups="jucct.group_academy_trainer_contract,jucct.group_user_management,base.group_system">
                            <notebook>
                                <page string="Contract Details">
                                    <field name="contract_ids" context="{'default_academy_id': id}" readonly="0">
                                        <form string="Contract">
                                            <sheet>
                                                <div class="oe_title">
                                                    <h1>
                                                        <field name="contract_number" placeholder="Contract Number" required="1"/>
                                                    </h1>
                                                </div>
                                                
                                                <group>
                                                    <group string="Contract Period">
                                                        <field name="start_date" required="1"/>
                                                        <field name="end_date" required="1"/>
                                                        <field name="status" readonly="1"/>
                                                    </group>
                                                    <group string="Contract Details">
                                                        <field name="revenue_share" required="1"/>
                                                        <field name="responsible_employee_id"/>
                                                    </group>
                                                </group>
                                                
                                                <group string="Notes / Attachments">
                                                    <field name="notes" placeholder="Enter contract-specific notes..." nolabel="1"/>
                                                    <field name="attachment_ids" widget="many2many_binary" 
                                                           options="{'no_create': True}" string="Contract Files"/>
                                                </group>
                                            </sheet>
                                        </form>
                                    </field>
                                </page>
                            </notebook>
                        </page>

                        <page string="Programs Offered">
                            <field name="offered_program_ids" readonly="contract_status != 'active'">
                                <list>
                                    <field name="program_id" filters="1"/>
                                    <field name="program_type" filters="1"/>
                                    <field name="price"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="status" widget="badge" 
                                           decoration-success="status == 'active'"
                                           decoration-danger="status == 'expired'"
                                           decoration-warning="status == 'draft'"/>
                                </list>
                            </field> 
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Academies List View -->
    <record id="academy_jucct_list_view" model="ir.ui.view">
        <field name="name">res.partner.list.academy</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Academies">
                <field name="name" string="Academy Name"/>
                <field name="contract_status" widget="badge" 
                       decoration-success="contract_status == 'active'"
                       decoration-danger="contract_status == 'expired'"
                       decoration-warning="contract_status == 'pending'"/>
                <field name="revenue_share" string="Commission %"/>
                <field name="contract_end_date"/>
                <field name="responsible_employee_id" string="Responsible Person"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <!-- Academies Search View -->
    <record id="academy_jucct_search_view" model="ir.ui.view">
        <field name="name">res.partner.search.academy</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Academies">
                <field name="name" string="Academy Name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="contact_person"/>
                <field name="responsible_employee_id"/>
                <field name="email"/>
                <field name="phone"/>
                
                <filter string="Active Contracts" name="filter_active" 
                        domain="[('contract_status', '=', 'active')]"/>
                <filter string="Expired Contracts" name="filter_expired" 
                        domain="[('contract_status', '=', 'expired')]"/>
                <filter string="Pending Contracts" name="filter_pending" 
                        domain="[('contract_status', '=', 'pending')]"/>
                
                <separator/>
                
                <filter string="Contract Ending This Month" name="filter_ending_this_month"
                        domain="[('contract_end_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('contract_end_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Contract Ending This Year" name="filter_ending_this_year"
                        domain="[('contract_end_date', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                                 ('contract_end_date', '&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d'))]"/>
                
                <group>
                    <filter string="Contract Status" name="group_status" context="{'group_by': 'contract_status'}"/>
                    <filter string="Responsible Employee" name="group_responsible" context="{'group_by': 'responsible_employee_id'}"/>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>