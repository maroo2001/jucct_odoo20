<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Report Template -->
    <template id="report_academy_financial_settlement_document">
        <t t-call="web.external_layout">
            <t t-set="settlement" t-value="o.with_context(lang=lang)"/>
            <t t-set="is_arabic" t-value="request.env.lang and request.env.lang.startswith('ar')"/>
            <div class="page" t-attf-style="direction: #{'rtl' if is_arabic else 'ltr'}; text-align: #{'right' if is_arabic else 'left'}; font-family: 'Cairo','Noto Naskh Arabic','Arial',sans-serif; color: #2c3e50;">
                
                <!-- Header Section -->
                <div class="text-center mb-4" style="margin-bottom:30px;">
                    <h2 class="mt-2" style="color: #000000; font-size:24px;">
                        <t t-translate="true">FINANCIAL SETTLEMENT</t>
                    </h2>
                </div>

                <!-- Settlement Information - Two Columns -->
                <div class="row mb-3" >
                    <div class="col-6" >
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">offering:</t></strong>
                            <span t-field="settlement.offering_id.display_name" style="font-size:18px; direction:ltr; unicode-bidi:embed"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Academy:</t></strong>
                            <span t-field="settlement.academy_id" style="font-size:18px;"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Program:</t></strong>
                            <span t-field="settlement.program_id" style="font-size:18px;"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Academy Share:</t></strong>
                            <span t-field="settlement.academy_share" t-options="{'widget': 'monetary', 'display_currency': settlement.currency_id}" style="font-size:18px;"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Center Share:</t></strong>
                            <span t-field="settlement.center_share" t-options="{'widget': 'monetary', 'display_currency': settlement.currency_id}" style="font-size:18px;"/>
                        </p>
                    </div>

                    <div class="col-6">
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Status:</t></strong>
                            <span t-field="settlement.settlement_status" t-options="{'widget': 'selection'}" style="font-size:18px;"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Program Price:</t></strong>
                            <span t-field="settlement.program_price" t-options="{'widget': 'monetary', 'display_currency': settlement.currency_id}" style="font-size:18px;"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Enrolled Students:</t></strong>
                            <span t-field="settlement.total_students" style="font-size:18px;"/>
                        </p>
                        <p style="margin:0; display:flex; gap:8px; align-items:center;">
                            <strong style="font-size:20px;"><t t-translate="true">Total Paid Amount:</t></strong>
                            <span t-field="settlement.total_paid_amount" t-options="{'widget': 'monetary', 'display_currency': settlement.currency_id}" style="font-size:18px;"/>
                        </p>
                    </div>
                </div>

                <hr style="border:1px solid #000;"/>

                <!-- Student Payments Details Table -->
                <h3 style="font-size:20px; font-weight:700; margin:20px 0 15px 0; text-transform: uppercase;">
                    <t t-translate="true">Student Payment Details</t>
                </h3>

                <table class="table table-sm table-bordered mt-3" style="width:100%; border-collapse: collapse;">
                    <thead style="background-color:#f2f2f2;">
                        <tr>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Student</t>
                            </th>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Program</t>
                            </th>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Paid</t>
                            </th>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Withdrawn</t>
                            </th>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Penalty</t>
                            </th>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Academy Share</t>
                            </th>
                            <th t-attf-style="padding:8px 10px; font-weight:600; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:20px;">
                                <t t-translate="true">Center Share</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="settlement.student_payment_ids" t-as="payment">
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-field="payment.student_id"/>
                            </td>
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-field="payment.program_id"/>
                            </td>
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-field="payment.total_paid"/>
                            </td>
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-if="payment.is_withdrawn"><t t-translate="true">Yes</t></span>
                                <span t-else=""><t t-translate="true">No</t></span>
                            </td>
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-field="payment.penalty_amount"/>
                            </td>
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-field="payment.academy_share"/>
                            </td>
                            <td t-attf-style="padding:6px 10px; border:1px solid #bdc3c7; text-align: #{'right' if is_arabic else 'center'}; font-size:18px;">
                                <span t-field="payment.center_share"/>
                            </td>
                        </tr>
                        <tr t-if="not settlement.student_payment_ids">
                            <td colspan="7" t-attf-style="padding:30px; text-align:center; color:#95a5a6; font-style:italic; border:1px solid #bdc3c7; font-size:18px;">
                                <t t-translate="true">No student payments found</t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Wrapper Template for Report -->
    <template id="report_academy_financial_settlement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="request.env.lang"/>
                <t t-call="jucct.report_academy_financial_settlement_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="academy_financial_settlement_report" model="ir.actions.report">
        <field name="name">Financial Settlement PDF</field>
        <field name="model">academy.financial.settlement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jucct.report_academy_financial_settlement_template</field>
        <field name="print_report_name">"Financial Settlement - %(display_name)s"</field>
        <field name="binding_model_id" ref="model_academy_financial_settlement"/>
        <field name="binding_type">report</field>
    </record>
</odoo>