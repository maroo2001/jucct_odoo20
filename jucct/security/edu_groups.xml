<odoo>
    <!-- ========================================================= -->
    <!--  BASE HIERARCHY                                           -->
    <!-- ========================================================= -->
    <!-- All internal users start from base.group_user             -->
    <!-- (i.e., they can log in and access the backend)            -->
    <record id="module_category_education" model="ir.module.category">
        <field name="name">Education Access</field>
        <field name="sequence">10</field>
    </record>

    <!-- Odoo 19+/20: groups are attached to a privilege, the privilege to a category -->
    <record id="privilege_education_base" model="res.groups.privilege">
        <field name="name">Education Base</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="jucct.module_category_education"/>
    </record>
    <record id="privilege_student_enrolment" model="res.groups.privilege">
        <field name="name">Student / Enrolment</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="jucct.module_category_education"/>
    </record>
    <record id="privilege_student_visibility" model="res.groups.privilege">
        <field name="name">Student Visibility</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="jucct.module_category_education"/>
    </record>
    <record id="privilege_user_management" model="res.groups.privilege">
        <field name="name">User Management</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="jucct.module_category_education"/>
    </record>
    <record id="privilege_record_visibility" model="res.groups.privilege">
        <field name="name">Record Visibility</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="jucct.module_category_education"/>
    </record>

    <record id="group_edu_user_base" model="res.groups">
        <field name="name">Education Base User</field>
        <field name="privilege_id" ref="jucct.privilege_education_base"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),(4, ref('event.group_event_registration_desk'))]"/> 
    </record>
    <!-- ========================================================= -->
    <!--  STUDENT / ENROLMENT ACCESS                               -->
    <!-- ========================================================= -->
    <record id="group_student_enrolment_read" model="res.groups">
        <field name="name">Student / Enrolment - Read Only</field>
        <field name="privilege_id" ref="jucct.privilege_student_enrolment"/>
        <field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base')), (4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Can view students and enrolments only.</field>
    </record>

    <record id="group_student_enrolment_rw" model="res.groups">
        <field name="name">Student / Enrolment - Read &amp; Write</field>
        <field name="privilege_id" ref="jucct.privilege_student_enrolment"/>
        <field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base')),(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Can view and manage students and enrolments.</field>
    </record>
    <record id="group_see_and_edit_own_students_only" model="res.groups">
        <field name="name">Can see Own students Only</field>
        <field name="privilege_id" ref="jucct.privilege_student_visibility"/>
        <field name="comment">
            Users can see only the students they created (create_uid).
        </field>
        <field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- ========================================================= -->
    <!--  ACADEMIES / TRAINERS ACCESS                              -->
    <!-- ========================================================= -->
    <record id="group_academy_trainer_read" model="res.groups">
        <field name="name">Academies &amp; Trainers - Read Only</field>
        <field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base'))]"/>
        <field name="comment">Can view academies and trainers.</field>
    </record>

    <record id="group_academy_trainer_rw" model="res.groups">
        <field name="name">Academies &amp; Trainers - Manage (No Contracts)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_partner_manager')),(4,ref('jucct.group_edu_user_base'))]"/>
        <field name="comment">Can create/update academies and trainers but not contracts.</field>
    </record>

    <record id="group_academy_trainer_contract" model="res.groups">
        <field name="name">Academies &amp; Trainers - Contract Management</field>
        <field name="implied_ids" eval="[(4, ref('group_academy_trainer_rw')),(4, ref('base.group_partner_manager')),(4,ref('jucct.group_edu_user_base'))]"/>
        <field name="comment">Can manage contracts for academies and trainers.</field>
    </record>

  <!-- ========================================================= -->
    <!--  Programs / Offerings Access                               -->
    <!-- ========================================================= -->
    <record id="group_course_offering_read" model="res.groups">
        <field name="name">Courses &amp; Offerings - Read Only</field>
	<field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base')), (4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Can view Program and offerings only.</field>
    </record>

    <record id="group_course_offering_rw" model="res.groups">
        <field name="name">Courses &amp; Offerings - Read &amp; Write</field>
        <field name="implied_ids" eval="[(4, ref('group_course_offering_read')),(4,ref('jucct.group_edu_user_base')),(4, ref('account.group_account_readonly')),(4, ref('product.group_product_manager'))]"/>
        <field name="comment">Can create and edit Programs and offerings.</field>
    </record>

    <!-- ========================================================= -->
    <!--  REPORTS / ANALYTICS ACCESS                               -->
    <!-- ========================================================= -->
    <record id="group_reports_analytics" model="res.groups">
        <field name="name">Reports &amp; Analytics</field>
            <field name="implied_ids" eval="[
        (4, ref('jucct.group_edu_user_base')),
        (4, ref('account.group_account_readonly'))       
    ]"/>

        <field name="comment">Can access dashboards, report and analytics.</field>
    </record>
        <record id="group_dashboard" model="res.groups">
        <field name="name">Dashboard Analytics</field>
            <field name="implied_ids" eval="[
        (4, ref('jucct.group_edu_user_base')),
        (4, ref('jucct.group_reports_analytics')),
      
    ]"/>
            <field name="comment">Can access dashboards</field>
    </record>
        <record id="group_reports" model="res.groups">
        <field name="name">Reports Analytics</field>
            <field name="implied_ids" eval="[
        (4, ref('jucct.group_edu_user_base')),
        (4, ref('jucct.group_reports_analytics')),   
      
    ]"/>
            <field name="comment">Can access report</field>
    </record>
        <record id="group_financial_analytics" model="res.groups">
        <field name="name">Financial Analytics</field>
            <field name="implied_ids" eval="[
        (4, ref('jucct.group_edu_user_base')),
        (4, ref('jucct.group_reports_analytics')),   
      
    ]"/>

        <field name="comment">Can access Financial analytics.</field>
    </record>


    <!-- ========================================================= -->
    <!--  USER MANAGEMENT                               -->
    <!-- ========================================================= -->
    <record id="group_user_management" model="res.groups">
        <field name="name">User Management (Limited)</field>
        <field name="privilege_id" ref="jucct.privilege_user_management"/>
            <field name="implied_ids" eval="[
        (4, ref('jucct.group_edu_user_base')),
        (4, ref('base.group_erp_manager')),
        (4, ref('base.group_user')),
        (4, ref('base.group_partner_manager')),          
    ]"/>

        <field name="comment">
            Can create and manage system users with restricted rights
        </field>
    </record>
        <record id="group_see_own_records" model="res.groups">
        <field name="name">Can see Own Records Only</field>
        <field name="privilege_id" ref="jucct.privilege_record_visibility"/>
        <field name="comment">
            Users can see only the records they created (create_uid).
        </field>
        <field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base'))]"/>
    </record>

    <record id="group_see_all_records" model="res.groups">
        <field name="name">Can see All Records</field>
        <field name="privilege_id" ref="jucct.privilege_record_visibility"/>
        <field name="comment">
            Users can see all records in the system regardless of ownership.
        </field>
        <field name="implied_ids" eval="[(4, ref('jucct.group_edu_user_base'))]"/>
    </record>

    <!-- Hide standard Odoo menus from non-admin users.
         Done through a tolerant Python helper (ir.ui.menu._jucct_restrict_menus) because
         several of these menu XML-ids differ between Community and Enterprise / between versions
         and a missing XML-id must not abort the module installation. -->
    <function model="ir.ui.menu" name="_jucct_restrict_menus"/>

</odoo>
