<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Scheduled Action to check expired certifications daily -->
    <record id="ir_cron_check_expired_certifications" model="ir.cron">
        <field name="name">Check Expired Certifications</field>
        <field name="model_id" ref="model_trainer_certification"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expired_certifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>