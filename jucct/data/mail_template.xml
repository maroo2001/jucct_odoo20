<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="jadara_user_invite_email" model="mail.template">
            <field name="name">Jadara Center: New User Invitation</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Welcome to Jadara University Center for Consulting and Training</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_formatted }}</field>
           
            <field name="lang">{{ object.lang }}</field>
            <field name="body_html" type="html">

<table border="0" cellpadding="0" cellspacing="0" 
       style="padding-top: 16px; background-color: #FFFFFF; 
              font-family:Verdana, Arial,sans-serif; 
              color: #333; width: 100%; border-collapse:separate;">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="600"
                   style="background-color: #fff; padding: 16px;">
                  <tr>
                    <td valign="middle" align="left">
                        <h2 style="color:#539273;">
                            <t t-out="object.company_id.name"/>
                        </h2>
                    </td>
                </tr>
                <tr><td><hr style="border:none; border-top:1px solid #ccc;"/></td></tr>
                <tr>
                    <td style="font-size:14px;">
                        <p>Dear <strong><t t-out="object.name or ''">User</t></strong>,</p>
                        <p>
                            <strong>Your request to reset your password from Jadara University Center for Consulting and Trainig has been approved</strong>.
                        </p>
                        <p>
                            Please click the button below to set your password and access your account:
                        </p>
                        <div style="margin:20px 0;text-align:center;">
                            <a t-att-href="object.partner_id._get_signup_url()"
                               style="background-color:#539273;color:#fff;
                                      padding:10px 20px;text-decoration:none;
                                      border-radius:5px;display:inline-block;">
                                Set My Password
                            </a>
                        </div>
                        <p>
                            This link will remain valid for 
                            <t t-out="int(int(object.env['ir.config_parameter'].sudo().search([('key', '=', 'auth_signup.signup.validity.hours')], limit=1).value or 24)/24)"></t> days.
                        </p>
                        <p>
                            Your login email is: 
                            <strong><t t-out="object.email or ''">example@jadara.edu</t></strong>
                        </p>
                        <br/>
                        <p>Thank you,</p>
                        <p><strong>The Jadara Center Team</strong></p>
                        <p style="font-size:11px;color:#777;">
                            This email was sent automatically. Please do not reply.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
            </field>
        </record>

    </data>
</odoo>